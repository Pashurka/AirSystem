<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AirSystem.Views.PollenPage"
             Title="Забруднення повітря">
    <ScrollView>
        <StackLayout Padding="10">
            <Label Text="Інформація про рівень пилку" FontSize="Large" HorizontalOptions="Center" />
            <ListView x:Name="PollenList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout Orientation="Vertical" Padding="5">
                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                <Label Text="{Binding IndexInfo.Category}" />
                                <Label Text="{Binding IndexInfo.IndexDescription}" />
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>
    </ScrollView>
</ContentPage>
